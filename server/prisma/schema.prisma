generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  email        String         @unique
  phone        String?
  city         String?
  country      String?
  bio          String?
  photoUrl     String?        @map("photo_url")
  passwordHash String         @map("password_hash")
  role         String         @default("TRAVELER") // 'SUPER_ADMIN' | 'AGENCY_ADMIN' | 'TRAVELER'
  isAdmin      Boolean        @default(false) @map("is_admin")
  createdAt    DateTime       @default(now()) @map("created_at")
  trips        Trip[]
  posts        CommunityPost[]
  tripMemberships TripMember[]

  @@map("users")
}

/// Seeded catalog city — read-only from the app's perspective.
model City {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  country    String
  region     String?
  costIndex  Decimal     @map("cost_index") @db.Decimal(6, 2)
  popularity Int         @default(0)
  imageUrl   String?     @map("image_url")
  lat        Decimal?    @db.Decimal(9, 6)
  lng        Decimal?    @db.Decimal(9, 6)
  activities Activity[]
  stops      TripStop[]

  @@index([name])
  @@map("cities")
}

/// Seeded catalog activity, scoped to a city.
model Activity {
  id             Int        @id @default(autoincrement())
  cityId         Int        @map("city_id")
  city           City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String // 'sightseeing' | 'food' | 'adventure' | 'culture' | 'relaxation'
  cost           Decimal    @default(0) @db.Decimal(8, 2)
  durationHours  Decimal    @default(1) @map("duration_hours") @db.Decimal(4, 1)
  imageUrl       String?    @map("image_url")
  stopActivities TripStopActivity[]

  @@unique([cityId, name])
  @@index([cityId])
  @@map("activities")
}

model Trip {
  id                      Int        @id @default(autoincrement())
  userId                  Int        @map("user_id")
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  startDate               DateTime   @map("start_date") @db.Date
  endDate                 DateTime   @map("end_date") @db.Date
  description             String?
  coverPhotoUrl           String?    @map("cover_photo_url")
  isPublic                Boolean    @default(false) @map("is_public")
  budgetTransportPerStop  Decimal?   @map("budget_transport_per_stop") @db.Decimal(8, 2)
  budgetStayPerDay        Decimal?   @map("budget_stay_per_day") @db.Decimal(8, 2)
  budgetMealsPerDay       Decimal?   @map("budget_meals_per_day") @db.Decimal(8, 2)
  totalBudget             Decimal?   @map("total_budget") @db.Decimal(10, 2)
  createdAt               DateTime   @default(now()) @map("created_at")
  stops                   TripStop[]
  posts                   CommunityPost[]
  members                 TripMember[]

  @@index([userId])
  @@map("trips")
}

/// A user who joined someone else's public trip to travel as a group.
model TripMember {
  id       Int      @id @default(autoincrement())
  tripId   Int      @map("trip_id")
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   Int      @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// A city visited within a trip, with its own date range.
model TripStop {
  id         Int                @id @default(autoincrement())
  tripId     Int                @map("trip_id")
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId     Int                @map("city_id")
  city       City               @relation(fields: [cityId], references: [id])
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  sortOrder  Int                @default(0) @map("sort_order")
  activities TripStopActivity[]

  @@index([tripId])
  @@map("trip_stops")
}

/// An activity scheduled into a specific stop.
model TripStopActivity {
  id             Int       @id @default(autoincrement())
  tripStopId     Int       @map("trip_stop_id")
  tripStop       TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activityId     Int       @map("activity_id")
  activity       Activity  @relation(fields: [activityId], references: [id])
  scheduledDate  DateTime  @map("scheduled_date") @db.Date
  scheduledTime  DateTime? @map("scheduled_time") @db.Time
  costOverride   Decimal?  @map("cost_override") @db.Decimal(8, 2)
  notes          String?

  @@index([tripStopId])
  @@map("trip_stop_activities")
}

/// A user sharing their trip experience in the Community feed.
model CommunityPost {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    Int?     @map("trip_id")
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  content   String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("community_posts")
}
